# CheckMark environment variables
# Copy this file and fill in values before running

# Leave empty for SQLite (local dev).
# turso provides this as TURSO_DATABASE_URL — copy that value here.
# TURSO_AUTH_TOKEN="eyXX.eyXX"
# TURSO_DATABASE_URL="libsql://your-db.turso.io"

# Random 32+ character string — generate with: openssl rand -base64 32
# The value below is a throwaway for local dev only. Never reuse it anywhere else.
JWT_SECRET=

# From resend.com (free tier)
# RESEND_API_KEY=re_xxxxxxxxxxxxx
# RESEND_FROM_EMAIL=noreply@kabirinnovations.com

# App base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Web Push (VAPID) — generated with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=xxxx
# VAPID_PRIVATE_KEY=xxx
# VAPID_EMAIL=mailto:kabir.innovate@gmail.com


# Cron endpoint secret — must match Authorization: Bearer <value> sent by GitHub Actions
CRON_SECRET=

# AES-256-GCM key for encrypted employee fields (PAN, Aadhaar, bank account).
# MUST be exactly 64 hex characters (32 bytes) or every employee read throws.
# Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The value below is a throwaway for local dev only — never use it in production,
# and note that changing this key makes already-encrypted rows unreadable.
FIELD_ENCRYPTION_KEY=
