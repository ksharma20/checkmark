# CheckMark environment variables
# Copy this file to .env.local and fill in values before running.
# Every secret below is intentionally empty: generate your own, never reuse one.

# Leave empty for SQLite (local dev).
# turso provides this as TURSO_DATABASE_URL — copy that value here.
# TURSO_AUTH_TOKEN="your-turso-auth-token"
# TURSO_DATABASE_URL="libsql://your-db.turso.io"

# Random 32+ character string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=

# From resend.com (free tier)
# RESEND_API_KEY=re_xxxxxxxxxxxxx
# RESEND_FROM_EMAIL=noreply@example.com

# App base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Web Push (VAPID) — generated with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=xxxx
# VAPID_PRIVATE_KEY=xxx
# VAPID_EMAIL=mailto:you@example.com

# Cron endpoint secret — must match Authorization: Bearer <value> sent by GitHub Actions.
# Generate with the same command as JWT_SECRET.
CRON_SECRET=

# AES-256-GCM key for encrypted employee fields (PAN, Aadhaar, bank account).
# MUST be exactly 64 hex characters (32 bytes) or every employee read throws.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this key makes already-encrypted rows unreadable.
FIELD_ENCRYPTION_KEY=
